# MoonTVPlus custom automatic updater
# install-nas.sh writes the real GitHub owner into config.env.

IMAGE=ghcr.io/YOUR_GITHUB_OWNER/moontvplus-custom:stable

LUNA_DIR=/vol2/1000/Docker/luna
COMPOSE_FILE=/vol2/1000/Docker/luna/docker-compose.yml
SERVICE=moontv-core
CONTAINER=moontv-core

HTTP_URL=http://127.0.0.1:8080/
HEALTH_ATTEMPTS=45
HEALTH_SLEEP_SECONDS=2

STATE_DIR=/vol2/1000/Docker/moontvplus-custom/auto-update/state
BACKUP_DIR=/vol2/1000/Docker/moontvplus-custom/auto-update/backups
LOG_DIR=/vol2/1000/Docker/moontvplus-custom/auto-update/logs
