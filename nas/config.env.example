# MoonTVPlus custom automatic updater
# install-nas.sh writes the real GitHub owner into config.env.

IMAGE=ghcr.io/YOUR_GITHUB_OWNER/moontvplus-custom:stable

LUNA_DIR=/vol2/1000/Docker/luna
COMPOSE_FILE=/vol2/1000/Docker/luna/docker-compose.yml
SERVICE=moontv-core
CONTAINER=moontv-core

HTTP_URL=http://127.0.0.1:8080/
HEALTH_ATTEMPTS=45
HEALTH_SLEEP_SECONDS=2

STATE_DIR=/vol2/1000/Docker/moontvplus-custom/auto-update/state
BACKUP_DIR=/vol2/1000/Docker/moontvplus-custom/auto-update/backups
LOG_DIR=/vol2/1000/Docker/moontvplus-custom/auto-update/logs

# Lightweight remote check first. If the stable digest has not changed, the
# updater exits in seconds and does not download image layers.
REMOTE_CHECK_RETRIES=3
REMOTE_CHECK_DELAY_SECONDS=10

# This NAS has shown repeated GHCR large-layer resets with Docker pull.
# Prefer Skopeo immediately instead of wasting time on Docker pull first.
PULL_STRATEGY=skopeo-first
SKOPEO_IMAGE=quay.io/skopeo/stable:latest
SKOPEO_RETRY_TIMES=10
SKOPEO_RETRY_DELAY=10s
SKOPEO_PARALLEL_COPIES=1

# Kvrocks pre-update protection
KVROCKS_CONTAINER=moontv-kvrocks
KVROCKS_PORT=6666
KVROCKS_BACKUP_ROOT=/vol2/1000/Docker/moontvplus-custom/auto-update/kvrocks-backups
KVROCKS_BACKUP_KEEP=7
KVROCKS_BGSAVE_TIMEOUT_SECONDS=300

# Safety default: never overwrite the production Kvrocks DB automatically.
KVROCKS_AUTO_RESTORE=0
