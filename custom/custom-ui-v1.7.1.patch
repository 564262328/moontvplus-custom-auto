+  .moontv-play-detail {
+    display: grid !important;
+    grid-template-columns: clamp(150px, 9.5vw, 178px) minmax(0, 1fr) !important;
+    gap: 18px !important;
+    padding: 15px 17px !important;
+    margin-top: 9px !important;
+    border-radius: 17px !important;
+  }
+
+  .moontv-play-poster-wrap {
+    grid-column: 1 !important;
+    order: 0 !important;
+    align-self: start;
+  }
+
+  .moontv-play-poster-wrap > div {
+    max-width: 172px !important;
+    margin: 0 !important;
+  }
+
+  .moontv-play-detail-copy {
+    grid-column: 2 !important;
+    min-width: 0;
+  }
+
+  .moontv-play-detail-copy > div {
+    padding: 6px 2px 4px 0 !important;
+  }
+
+  .moontv-play-detail-title {
+    margin-bottom: 8px !important;
+    font-size: clamp(1.45rem, 1.65vw, 1.95rem) !important;
+    line-height: 1.12 !important;
+    gap: 7px !important;
+  }
+
+  .moontv-play-detail-title > button {
+    width: 32px !important;
+    height: 32px !important;
+    border-radius: 9px !important;
+  }
+
+  .moontv-play-meta {
+    gap: 7px !important;
+    margin-bottom: 8px !important;
+    font-size: 0.8rem !important;
+  }
+
+  .moontv-play-meta > span {
+    min-height: 25px !important;
+    padding: 3px 8px !important;
+    border-radius: 7px !important;
+  }
+
+  .moontv-play-description {
+    max-width: none !important;
+    padding-right: 12px !important;
+    font-size: 0.86rem !important;
+    line-height: 1.58 !important;
+    opacity: 0.82 !important;
+  }
+
+  /* Desktop libraries: compact when sparse, generous multi-column canvas when full. */
+  .moontv-favorites-panel,
+  .moontv-history-panel {
+    width: min(1180px, calc(100vw - 150px)) !important;
+    max-height: min(86vh, 860px) !important;
+  }
+
+  .moontv-favorites-panel[data-item-count='0'],
+  .moontv-history-panel[data-item-count='0'] {
+    width: min(660px, calc(100vw - 120px)) !important;
+  }
+
+  .moontv-favorites-panel[data-item-count='1'],
+  .moontv-history-panel[data-item-count='1'] {
+    width: min(500px, calc(100vw - 120px)) !important;
+  }
+
+  .moontv-favorites-panel[data-item-count='2'],
+  .moontv-history-panel[data-item-count='2'] {
+    width: min(720px, calc(100vw - 120px)) !important;
+  }
+
+  .moontv-favorites-panel[data-item-count='3'],
+  .moontv-history-panel[data-item-count='3'] {
+    width: min(900px, calc(100vw - 120px)) !important;
+  }
+
+  .moontv-library-body {
+    padding: 22px 24px 28px !important;
+  }
+
+  .moontv-library-grid {
+    grid-template-columns: repeat(auto-fill, minmax(145px, 1fr)) !important;
+    column-gap: 22px !important;
+    row-gap: 48px !important;
+  }
+
+  .moontv-library-grid .media-card {
+    max-width: 180px !important;
+  }
+
+  /* Home stays visually frozen; only allow better use of wide monitors. */
+  .home-content > div {
+    max-width: 1840px !important;
+  }
+
+  .hero-wrap {
+    padding-left: 14px !important;
+    padding-right: 14px !important;
+  }
+}
+
+@media (min-width: 1700px) {
+  .moontv-play-page {
+    max-width: 2040px !important;
+    padding-left: 34px !important;
+    padding-right: 34px !important;
+  }
+
+  .moontv-play-grid:not(.grid-cols-1) {
+    grid-template-columns: minmax(0, 1fr) 360px !important;
+    height: clamp(680px, calc(100vh - 235px), 820px) !important;
+  }
+
+  .moontv-play-detail {
+    grid-template-columns: 176px minmax(0, 1fr) !important;
+    padding: 16px 18px !important;
+  }
+
+  .home-content > div {
+    max-width: 1920px !important;
+  }
+}
+
+/* Preserve the mobile/tablet layout exactly as-is in V1.7. */
+/* ========================================================================
+   MoonTVPlus Custom UI V1.7.1 Detail Grid Hotfix
+   Fix desktop detail poster/copy placement after V1.7.
+   ======================================================================== */
+
+@media (min-width: 1280px) {
+  .moontv-play-detail {
+    align-items: start !important;
+  }
+
+  .moontv-play-detail-copy {
+    grid-column: 2 !important;
+    grid-row: 1 !important;
+    align-self: start !important;
+  }
+
+  .moontv-play-poster-wrap {
+    grid-column: 1 !important;
+    grid-row: 1 !important;
+    align-self: start !important;
+  }
+
+  /* Prevent the poster from being auto-placed onto a second grid row. */
+  .moontv-play-poster-wrap > div {
+    width: 100% !important;
+  }
+}
