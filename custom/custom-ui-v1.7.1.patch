+
+/* ========================================================================
+   MoonTVPlus Custom UI V1.2 Polish
+   Refines density, sidebar hierarchy, hero readability, cards and desktop
+   action controls. CSS-only: no playback/search/API/storage logic changes.
+   ======================================================================== */
+:root {
+  --mtv-v12-sidebar-separator: rgba(15, 23, 42, 0.08);
+  --mtv-v12-personal-surface: rgba(248, 250, 252, 0.62);
+  --mtv-v12-control-surface: rgba(248, 250, 252, 0.78);
+  --mtv-v12-control-hover: rgba(34, 197, 94, 0.10);
+}
+
+.dark {
+  --mtv-v12-sidebar-separator: rgba(255, 255, 255, 0.075);
+  --mtv-v12-personal-surface: rgba(255, 255, 255, 0.028);
+  --mtv-v12-control-surface: rgba(9, 14, 20, 0.78);
+  --mtv-v12-control-hover: rgba(34, 197, 94, 0.12);
+}
+
