+/* ========================================================================
+   MoonTVPlus Custom UI V1
+   Visual-only overrides: navigation, hero, media cards and responsive shell.
+   Keep business logic untouched so upstream upgrades remain easier to merge.
+   ======================================================================== */
+:root {
+  --mtv-accent: #22c55e;
+  --mtv-accent-strong: #16a34a;
+  --mtv-accent-soft: rgba(34, 197, 94, 0.14);
+  --mtv-surface: rgba(255, 255, 255, 0.72);
+  --mtv-surface-strong: rgba(255, 255, 255, 0.9);
+  --mtv-border: rgba(15, 23, 42, 0.08);
+  --mtv-text-muted: rgba(51, 65, 85, 0.72);
+  --mtv-radius-xl: 22px;
+  --mtv-radius-lg: 16px;
+  --mtv-shadow-soft: 0 18px 45px rgba(15, 23, 42, 0.12);
+}
+
+.dark {
+  --mtv-surface: rgba(8, 12, 18, 0.72);
+  --mtv-surface-strong: rgba(10, 14, 20, 0.9);
+  --mtv-border: rgba(255, 255, 255, 0.08);
+  --mtv-text-muted: rgba(226, 232, 240, 0.68);
+  --mtv-shadow-soft: 0 22px 54px rgba(0, 0, 0, 0.34);
+}
